{deps, [
    {cowboy, "2.10.0"},
    {cowboy_telemetry, "0.4.0"},
    {cowlib, "2.12.0"},
    {ranch, "1.8.0"},
    {jsone, "1.9.0"},
    {erlydtl, "0.15.0", {git, "https://github.com/erlydtl/erlydtl.git", {tag, "0.15.0"}}}
]}.
{relx, [
  {release, {app, "1.0.0"}, [app]},
  {sys_config, "./config/sys.config"},
  {dev_mode, true},
  {include_erts, false}
]}.
{erl_opts, [debug_info, warn_export_all]}.
