{% extends "components/base.html" %}
{% block content %}
<main>
  <h1>Consultation Services</h1>
  <p>I help individuals and teams improve their systems, thinking, and problem-solving methods.</p>
  <h2>Areas of Expertise</h2>
  <ul>
    <li>Backend architecture (Python, Erlang/BEAM, Elixir)</li>
    <li>Async systems, reliability, error handling strategies</li>
    <li>Stoic philosophical reasoning — clarity in decisions</li>
    <li>Ancient Greek language fundamentals & translation</li>
  </ul>
  <h2>Book a Session</h2>
  <form action="" method="POST">
    <label>Email</label>
    <input type="email" placeholder="you@mail.com" autocomplete="email" id="email" required>
    <label>Message</label>
    <textarea rows="5" placeholder="Describe your request..." required></textarea>
    <input type="submit" value="Send Request">
  </form>
</main>
{% endblock %}
